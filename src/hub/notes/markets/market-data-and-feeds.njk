        <button type="button" data-level="2" aria-pressed="false">Level 2</button>
        <button type="button" data-level="3" aria-pressed="false">Level 3</button>
      </div>
    </div>
    <svg class="chart" id="chart-levels" viewBox="0 0 640 330" role="img" aria-label="An order book of prices to sell above and prices to buy below, showing more or less depending on the data level"></svg>
    <p class="look" id="levels-story"></p>
  </div>
  <div class="table-wrap">
    <table class="numbers">
      <thead><tr><th>Level</th><th>What you see</th><th>Who needs it</th></tr></thead>
      <tbody>
        <tr><td>Level 1</td><td>The best price to buy and to sell, how much is there, and the last trade</td><td>Almost everyone. It's what a normal trading app shows, and it's cheap or free.</td></tr>
        <tr><td>Level 2</td><td>Every price in the order book and how much is waiting at each one: the market's {% gl "market depth" %}depth{% endgl %}</td><td>Traders working out how much they can buy or sell before the price moves</td></tr>
